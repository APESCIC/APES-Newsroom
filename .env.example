APP_NAME="APES Newsroom"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/London

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# Local/CI default: sqlite, zero setup required.
# In Cloudron, CloudronEnvironmentServiceProvider (app/Providers) overrides
# these from CLOUDRON_MYSQL_* at runtime - do not hand-edit DB_* in the
# Cloudron environment, and never commit real values here.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Redis ----------------------------------------------------------------
# Overridden from CLOUDRON_REDIS_* at runtime in Cloudron (see
# CloudronEnvironmentServiceProvider). Cloudron's LAMP app ships the
# php-redis extension, hence phpredis; predis/predis is available as a
# portable fallback for environments without the extension.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail -------------------------------------------------------------
# Overridden from CLOUDRON_MAIL_SMTP_* at runtime in Cloudron. Never use
# PHP's mail() - Cloudron's sendmail is not configured (see LAMP docs).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="newsroom@apesnews.org.uk"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Cloudron addon variables (informational) --------------------------
# These are injected by the Cloudron runtime for app ID
# 74a2a784-a161-4787-84ff-2b8efc957bc8 and are NOT set here - listed only
# so local/CI setup documents what production actually uses. They rotate
# on restart; the app must always read them via getenv()/env(), never
# cache or copy them. See docs/deployment.md and docs.cloudron.io/
# packaging/addons.
#
# CLOUDRON_MYSQL_HOST, CLOUDRON_MYSQL_PORT, CLOUDRON_MYSQL_DATABASE,
# CLOUDRON_MYSQL_USERNAME, CLOUDRON_MYSQL_PASSWORD
# CLOUDRON_REDIS_HOST, CLOUDRON_REDIS_PORT, CLOUDRON_REDIS_PASSWORD
# CLOUDRON_MAIL_SMTP_SERVER, CLOUDRON_MAIL_SMTP_PORT,
# CLOUDRON_MAIL_SMTP_USERNAME, CLOUDRON_MAIL_SMTP_PASSWORD,
# CLOUDRON_MAIL_FROM, CLOUDRON_MAIL_FROM_DISPLAY_NAME
# CLOUDRON_LDAP_URL, CLOUDRON_LDAP_USERS_BASE_DN,
# CLOUDRON_LDAP_GROUPS_BASE_DN, CLOUDRON_LDAP_BIND_DN,
# CLOUDRON_LDAP_BIND_PASSWORD
# CLOUDRON_OIDC_DISCOVERY_URL, CLOUDRON_OIDC_ISSUER,
# CLOUDRON_OIDC_CLIENT_ID, CLOUDRON_OIDC_CLIENT_SECRET
# CLOUDRON_APP_ORIGIN, CLOUDRON_PROXY_IP
